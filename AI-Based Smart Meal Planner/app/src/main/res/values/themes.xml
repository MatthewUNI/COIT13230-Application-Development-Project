<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Base.Theme.AIBasedSmartMealPlanner"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Main application colours -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <item name="colorSecondary">@color/primary_green</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>

        <!-- Screen colours -->
        <item name="android:colorBackground">@color/screen_background</item>
        <item name="colorSurface">@color/screen_background</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:navigationBarColor">@color/screen_background</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

    </style>

    <!-- Application theme -->
    <style name="Theme.AIBasedSmartMealPlanner"
        parent="Base.Theme.AIBasedSmartMealPlanner" />

    <!-- Reusable input field style -->
    <style name="AppInputBox">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

</resources>